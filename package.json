{
  "name": "curloop",
  "version": "0.3.3",
  "description": "Unattended Cursor harness (Windows, TypeScript): CDP-drive real Cursor through a TODO.md queue, auto-switch accounts on usage/login limits, product-grade Web console.",
  "keywords": [
    "cursor",
    "cursor-ide",
    "cdp",
    "chrome-devtools-protocol",
    "automation",
    "unattended",
    "harness",
    "cli",
    "ai-coding",
    "agent",
    "windows",
    "typescript",
    "todo",
    "web-ui"
  ],
  "author": "deatz <3446914219@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daetz-coder/CurLoop.git"
  },
  "homepage": "https://www.npmjs.com/package/curloop",
  "bugs": {
    "url": "https://github.com/daetz-coder/CurLoop/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "curloop": "bin/curloop.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.copyFileSync('src/win32.ps1','dist/win32.ps1');fs.cpSync('src/web','dist/web',{recursive:true});fs.cpSync('src/assets','dist/assets',{recursive:true})\"",
    "prepack": "npm run build",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "minimist": "^1.2.8",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "config.default.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ]
}
