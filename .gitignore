# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---------- Harness 运行产物（运行时生成，不入库） ----------
# 隔离测试 profile（verify_*.py 默认使用）
.harness-profile/
# 运行状态：事件日志 / 快照 / 换号模板副本
unattended/runstate/
# _selftest 回归夹具的运行产物（夹具本身保留）
_selftest/plan_step*.txt
_selftest/__pycache__/

# ---------- 日志 / 临时 ----------
*.log
*.tmp
*.bak

# ---------- Reasonix 运行数据（工具自身状态，不入库） ----------
.reasonix/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp

# ---------- Windows / 系统 ----------
Thumbs.db
Desktop.ini
.DS_Store
